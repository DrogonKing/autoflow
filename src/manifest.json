{
  "manifest_version": 3,
  "name": "AutoFlow \u2014 Click, Fill, Record & Schedule",
  "version": "1.15.0",
  "description": "Auto-click, fill and record browser automations. Schedule them by date, interval or cron. Loop, branch and drive them from CSV.",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "notifications",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "action": {
    "default_title": "AutoFlow",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "start-stop": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Start or stop the current automation"
    },
    "panic-stop": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Stop everything immediately"
    },
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open the side panel"
    },
    "pick-element": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pick an element on the page"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
