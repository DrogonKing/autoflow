{
  "name": "autoflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AutoFlow — auto-click, fill, record and schedule browser automations.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-test.mjs",
    "test:e2e": "node scripts/e2e-test.mjs",
    "test:all": "vitest run && npm run build && node scripts/browser-test.mjs && node scripts/e2e-test.mjs",
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build-firefox.mjs",
    "build:all": "node scripts/build.mjs && node scripts/build-firefox.mjs",
    "lint:firefox": "web-ext lint --source-dir=dist-firefox",
    "test:firefox": "node scripts/firefox-test.mjs",
    "test:security": "node scripts/firefox-security-test.mjs",
    "audit:security": "python3 scripts/adversarial_review.py",
    "audit:firefox": "python3 scripts/firefox_security_audit.py",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "vitest": "^2.1.8"
  }
}
